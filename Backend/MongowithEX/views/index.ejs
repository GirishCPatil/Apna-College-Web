<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>All Chats</h1>
    <form method="get"  action="/chats/new">
        <button>Add New Chat</button>
    </form>
    <div class="chats">
       <%  for(let chat of chats){ %> 
            <div class="chat">
                <h3>From : <%= chat.from %></h3>
                <p><%= chat.message %></p>
                <p>Recieved By : <%= chat.to %></p>
                <hr>
                <p><%= chat.createdAt.toString().split(" ")[4] %></p>
                <p><%= chat.createdAt.toString().split(" ").slice(0,4).join(" ") %></p>

                <form action="/chats/<%=chat.id%>/edit" method="get">
                    <Button>Edit</Button>
                </form>
            </div>
        <% } %>
   
    
    </div>
</body>
</html>

