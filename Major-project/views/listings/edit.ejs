<% layout("./layouts/boilerplate.ejs")%>


<body>
        
    <div class="row">
        <div class="col-8 offset-2">
            <br><br>
            <h2>Edit your listing!</h2>
            <form action="/listings/<%=detaillist._id%>?_method=PATCH" method="post" novalidate class=" needs-validation">
                <div class="mb-3"><label class="form-label" for="title">Title</label>
                    <input required type="text" value="<%=detaillist.title%>" name="title" placeholder="Add a catchy title" class="form-control">
          
             <div class="invalid-feedback">Title is required..</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="description">Description</label>
                    <textarea required name="description" class="form-control" placeholder="description"><%=detaillist.description%></textarea>
                    
                    <div class="invalid-feedback">Desc is required..</div>
                </div>
                <div class="mb-3"><label class="form-label" for="image">Image</label>
                    <input  required type="text" name="image" class="form-control" placeholder="enter url/link">
                    
                    <div class="invalid-feedback">Image is required..</div>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4"><label class="form-label" for="price">Price</label>
                        <input required type="number " value="<%=detaillist.price%>" name="price" class="form-control" placeholder="1200">
                     
                        <div class="invalid-feedback">Price is required..</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label class="form-label" for="country">Country</label>
                        <input required type="text " value="<%=detaillist.country%>" class="form-control" name="country" placeholder="India">
                        <div class="invalid-feedback">Country is required..</div>

                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label"  for="location">Location</label>
                    <input required type="text " value="<%=detaillist.location%>" class="form-control" name="location" placeholder="Jaipur,Rajasthan">
                    <div class="invalid-feedback">Location is required..</div>
                </div>

                <br>
                <button class="btn btn-dark add-btn">Edit</button>
                <br><br>
            </form>
        </div>
    </div>
</body>



